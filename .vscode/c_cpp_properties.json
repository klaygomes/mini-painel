{
    "version": 4,
    "configurations": [
        {
            "name": "mini-painel",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "macos-clang-arm64",
            "cStandard": "gnu99",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/device",
                "${workspaceFolder}/src/dashboard",
                "${workspaceFolder}/src/draw",
                "${workspaceFolder}/src/components",
                "${workspaceFolder}/src/theme",
                "${workspaceFolder}/src/protocol",
                "${workspaceFolder}/src/serial",
                "${workspaceFolder}/src/image",
                "${workspaceFolder}/src/gfx",
                "${workspaceFolder}/vendor/mjson"
            ],
            "defines": []
        }
    ]
}
