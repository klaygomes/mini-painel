/* XF_KIND(name, data_size, height) — create_##name, decode_##name, encode_##name are derived */
XF_KIND(header,       sizeof(comp_header_data_t),       COMP_HEADER_HEIGHT)
XF_KIND(divider,      0,                                COMP_DIVIDER_HEIGHT)
XF_KIND(spacer,       0,                                COMP_SPACER_HEIGHT)
XF_KIND(deploy,       sizeof(comp_deploy_data_t),       COMP_DEPLOY_HEIGHT)
XF_KIND(build_status, sizeof(comp_build_status_data_t), COMP_BUILD_STATUS_HEIGHT)
XF_KIND(metrics,      sizeof(comp_metrics_data_t),      COMP_METRICS_HEIGHT)
XF_KIND(sparkline,    sizeof(comp_sparkline_data_t),    COMP_SPARKLINE_HEIGHT)
XF_KIND(error_rate,   sizeof(comp_error_rate_data_t),   COMP_ERROR_RATE_HEIGHT)
XF_KIND(alerts,       sizeof(comp_alerts_data_t),       COMP_ALERTS_HEIGHT)
XF_KIND(outages,      sizeof(comp_outages_data_t),      COMP_OUTAGES_HEIGHT)
XF_KIND(sprint,       sizeof(comp_sprint_data_t),       COMP_SPRINT_HEIGHT)
XF_KIND(team_status,  sizeof(comp_team_status_data_t),  COMP_TEAM_STATUS_HEIGHT)
XF_KIND(oncall,       sizeof(comp_oncall_data_t),       COMP_ONCALL_HEIGHT)
XF_KIND(sla_gauge,    sizeof(comp_sla_gauge_data_t),    COMP_SLA_GAUGE_HEIGHT)
XF_KIND(schedule,     sizeof(comp_schedule_data_t),     COMP_SCHEDULE_HEIGHT)
XF_KIND(pr_review,    sizeof(comp_pr_review_data_t),    COMP_PR_REVIEW_HEIGHT)
